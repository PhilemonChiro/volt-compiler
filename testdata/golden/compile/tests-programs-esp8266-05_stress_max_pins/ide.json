 "format_code": "chip esp8266\n\nhardware {\n    pin p0: Output = 0\n    pin p2: Output = 2\n    pin p4: Output = 4\n    pin p5: Output = 5\n    pin p12: Output = 12\n    pin p13: Output = 13\n    pin p14: Output = 14\n    pin p15: Output = 15\n    pin p16: Output = 16\n}\n\nvar c0: int = 0\n\nvar c2: int = 0\n\nvar c4: int = 0\n\nvar c5: int = 0\n\nvar c12: int = 0\n\nvar c13: int = 0\n\nvar c14: int = 0\n\nvar c15: int = 0\n\nvar c16: int = 0\n\nvar net_count: int = 0\n\ntask t1 {\n    every 100ms {\n        p0.toggle()\n        c0 += 1\n    }\n}\n\ntask t2 {\n    every 200ms {\n        p2.toggle()\n        c2 += 1\n    }\n}\n\ntask t3 {\n    every 300ms {\n        p4.toggle()\n        c4 += 1\n    }\n}\n\ntask t4 {\n    every 400ms {\n        p5.toggle()\n        c5 += 1\n    }\n}\n\ntask t5 {\n    every 500ms {\n        p12.toggle()\n        c12 += 1\n    }\n}\n\ntask t6 {\n    every 600ms {\n        p13.toggle()\n        c13 += 1\n    }\n}\n\ntask t7 {\n    every 700ms {\n        p14.toggle()\n        c14 += 1\n    }\n}\n\ntask t8 {\n    every 800ms {\n        p15.toggle()\n        c15 += 1\n    }\n}\n\ntask t9 {\n    every 900ms {\n        p16.toggle()\n        c16 += 1\n    }\n}\n\ntask net {\n    every 10s {\n        net_count += 1\n        mqtt.send_int(\"stress/alive\", net_count)\n        log(\"net\", \"#\" + net_count + \" mqtt sent\")\n    }\n}\n\ntask stress_report {\n    every 5s {\n        log(\"stress\", \"GPIO0=\" + c0 + \" GPIO2=\" + c2 + \" GPIO4=\" + c4 + \" GPIO5=\" + c5)\n        log(\"stress\", \"GPIO12=\" + c12 + \" GPIO13=\" + c13 + \" GPIO14=\" + c14 + \" GPIO15=\" + c15 + \" GPIO16=\" + c16)\n        log(\"stress\", \"net=\" + net_count + \" wifi=\" + wifi.is_connected() + \" heap=\" + system.free_heap())\n    }\n}\n\nsetup {\n    wifi.connect(\"StressNet\", \"password\")\n    mqtt.connect(\"mqtt://broker.local\")\n}\n",
