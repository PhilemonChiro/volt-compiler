 "format_code": "chip esp32\n\nhardware {\n    pin red: Output = 23\n    pin green: Output = 22\n    pin yellow: Output = 21\n    pin button: PullUpInput = 4\n    pin sensor: Analog = 36\n}\n\nsetup {\n    log(\"system\", \"multi-pin demo: red=23, green=22, yellow=21, button=4, adc=36\")\n}\n\nvar red_count: int = 0\n\nvar green_count: int = 0\n\nvar button_presses: int = 0\n\nvar last_button: int = 1\n\ntask blink_red {\n    every 100ms {\n        red.toggle()\n        red_count += 1\n        if red_count % 10 == 0 {\n            log(\"red\", \"toggles=\" + red_count)\n        }\n    }\n}\n\ntask blink_green {\n    every 400ms {\n        green.toggle()\n        green_count += 1\n        log(\"green\", \"toggle #\" + green_count)\n    }\n}\n\ntask read_button {\n    every 50ms {\n        let state = button.read()\n        if state == 0 {\n            if last_button == 1 {\n                button_presses += 1\n                log(\"button\", \"PRESSED #\" + button_presses)\n            }\n            yellow.on()\n        } else {\n            yellow.off()\n        }\n        last_button = state\n    }\n}\n\ntask adc_monitor {\n    every 2s {\n        let val = sensor.read()\n        log(\"adc\", \"GPIO36 ADC1_CH0 raw=\" + val)\n    }\n}\n",
